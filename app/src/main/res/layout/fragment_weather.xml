<?xml version="1.0" encoding="utf-8"?>
<!-- H02 天气详情 · 农事指数（原型 Weather.dc.html） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.heban.app.ui.home.WeatherFormat" />

        <variable
            name="vm"
            type="com.heban.app.ui.home.WeatherViewModel" />

        <variable
            name="onPickCity"
            type="android.view.View.OnClickListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <!-- 顶栏：返回、地点（Title Large，前面是 Primary 色定位图标）、切换地区 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.HeBan.Toolbar"
            android:layout_width="match_parent"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_arrow_back">

            <LinearLayout
                android:id="@+id/title_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/location_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location_on_fill"
                    app:tint="?attr/colorPrimary"
                    app:visible="@{vm.state.locationName() != null}" />

                <TextView
                    android:id="@+id/location_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{vm.state.locationName() ?? @string/weather_title}"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_switch"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/weather_cd_switch"
                android:onClick="@{onPickCity}"
                android:src="@drawable/ic_edit_location_alt"
                app:tint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/page_margin"
                    android:paddingTop="4dp"
                    android:paddingBottom="@dimen/section_gap">

                    <!-- 离线提示栏 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/card_gap"
                        app:visible="@{vm.state.showOffline()}">

                        <include
                            android:id="@+id/offline"
                            layout="@layout/weather_view_offline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:text="@{WeatherFormat.offlineText(context, vm.state)}" />
                    </FrameLayout>

                    <!-- 降温预警（详细文案） -->
                    <LinearLayout
                        android:id="@+id/alert_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/card_gap"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/home_bg_round12"
                        android:backgroundTint="?attr/colorWarningContainer"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/page_margin"
                        android:paddingVertical="12dp"
                        app:visible="@{vm.state.showAlert()}">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ac_unit"
                            app:tint="?attr/colorOnWarningContainer" />

                        <TextView
                            android:id="@+id/alert_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@{WeatherFormat.detailAlert(context, vm.state)}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnWarningContainer" />
                    </LinearLayout>

                    <!-- 当前天气 + 逐小时：Primary Container，圆角 28，内边距 20 -->
                    <LinearLayout
                        android:id="@+id/current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_bg_round28"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:orientation="vertical"
                        android:paddingVertical="20dp"
                        app:visible="@{vm.state.hasData()}">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp">

                            <ImageView
                                android:id="@+id/current_icon"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:importantForAccessibility="no"
                                android:src="@{context.getDrawable(WeatherFormat.nowIcon(vm.state.bundle()))}"
                                app:tint="?attr/colorOnPrimaryContainer" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/icon_text_gap"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <!-- Display Large 57/64：去掉字体内边距，行高固定 64dp -->
                                <TextView
                                    android:id="@+id/current_temp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="64dp"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:text="@{WeatherFormat.nowTemp(vm.state)}"
                                    android:textAppearance="?attr/textAppearanceDisplayLarge"
                                    android:textColor="?attr/colorOnPrimaryContainer" />

                                <TextView
                                    android:id="@+id/current_detail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@{WeatherFormat.currentDetail(context, vm.state.bundle())}"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/hourly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/page_margin"
                            android:clipToPadding="true"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="20dp" />
                    </LinearLayout>

                    <!-- 骨架屏 -->
                    <LinearLayout
                        android:id="@+id/skeleton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/home_bg_round28"
                        android:backgroundTint="?attr/colorSurfaceContainerLow"
                        android:contentDescription="@string/weather_loading"
                        android:orientation="vertical"
                        android:padding="20dp"
                        app:visible="@{vm.state.showSkeleton()}">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/home_bg_circle"
                                android:backgroundTint="?attr/colorSurfaceContainerHighest" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/icon_text_gap"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="96dp"
                                    android:layout_height="56dp"
                                    android:background="@drawable/home_bg_round12"
                                    android:backgroundTint="?attr/colorSurfaceContainerHighest" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="12dp"
                                    android:layout_marginTop="10dp"
                                    android:background="@drawable/home_bg_round8"
                                    android:backgroundTint="?attr/colorSurfaceContainerHighest" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="@dimen/page_margin"
                            android:background="@drawable/home_bg_round12"
                            android:backgroundTint="?attr/colorSurfaceContainerHighest" />
                    </LinearLayout>

                    <!-- 没有缓存时的报错 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:visible="@{vm.state.showError()}">

                        <include
                            android:id="@+id/weather_error"
                            layout="@layout/weather_view_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:onPickCity="@{onPickCity}"
                            app:onRetry="@{v -> vm.refresh()}"
                            app:ui="@{vm.state}" />
                    </FrameLayout>

                    <!-- 今日农事指数 -->
                    <LinearLayout
                        android:id="@+id/indices_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="vertical"
                        app:visible="@{vm.state.hasIndices()}">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:accessibilityHeading="true"
                            android:text="@string/weather_indices_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/indices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <!-- 未来 7 天 -->
                    <LinearLayout
                        android:id="@+id/week_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="vertical"
                        app:visible="@{vm.state.hasDaily()}">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:accessibilityHeading="true"
                                android:text="@string/weather_week_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/updated_at"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{WeatherFormat.updatedAt(context, vm.state)}"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/daily"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/home_bg_round16"
                            android:backgroundTint="?attr/colorSurfaceContainerLow"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingVertical="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</layout>
