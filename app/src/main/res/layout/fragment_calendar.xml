<?xml version="1.0" encoding="utf-8"?>
<!-- H03 农事日历（原型 Calendar.dc.html）：月份切换、7 列月历（节气、农事圆点）、图例、所选日期的农事与节气提示 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vm"
            type="com.heban.app.ui.home.CalendarViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.HeBan.Toolbar"
                android:layout_width="match_parent"
                app:contentInsetEnd="0dp"
                app:contentInsetEndWithActions="0dp"
                app:navigationContentDescription="@string/back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="@string/calendar_title">

                <ImageButton
                    android:id="@+id/btn_today"
                    style="@style/Widget.HeBan.Calendar.IconButton"
                    android:layout_gravity="end"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/calendar_today"
                    android:onClick="@{() -> vm.goToday()}"
                    android:src="@drawable/ic_today" />
            </com.google.android.material.appbar.MaterialToolbar>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- 月份：2026年10月 ▾ ‹ › -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="24dp"
                        android:paddingEnd="8dp">

                        <LinearLayout
                            android:id="@+id/btn_month"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_month"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="2026年10月" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="4dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_arrow_drop_down"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_prev"
                            style="@style/Widget.HeBan.Calendar.IconButton"
                            android:contentDescription="@string/calendar_prev_month"
                            android:onClick="@{() -> vm.previousMonth()}"
                            android:src="@drawable/ic_chevron_left" />

                        <ImageButton
                            android:id="@+id/btn_next"
                            style="@style/Widget.HeBan.Calendar.IconButton"
                            android:contentDescription="@string/calendar_next_month"
                            android:onClick="@{() -> vm.nextMonth()}"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <!-- 星期行（周日开头） -->
                    <LinearLayout
                        android:id="@+id/week_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <TextView
                            style="@style/Widget.HeBan.Calendar.WeekLabel"
                            android:text="@{@stringArray/calendar_weekdays[0]}" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.WeekLabel"
                            android:text="@{@stringArray/calendar_weekdays[1]}" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.WeekLabel"
                            android:text="@{@stringArray/calendar_weekdays[2]}" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.WeekLabel"
                            android:text="@{@stringArray/calendar_weekdays[3]}" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.WeekLabel"
                            android:text="@{@stringArray/calendar_weekdays[4]}" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.WeekLabel"
                            android:text="@{@stringArray/calendar_weekdays[5]}" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.WeekLabel"
                            android:text="@{@stringArray/calendar_weekdays[6]}" />
                    </LinearLayout>

                    <!-- 月历：RecyclerView + GridLayoutManager(7) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="12dp" />

                    <!-- 图例 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="24dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="16dp">

                        <View
                            style="@style/Widget.HeBan.Calendar.LegendDot"
                            android:backgroundTint="?attr/colorPrimary" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.LegendText"
                            android:text="@string/calendar_legend_manage" />

                        <View
                            style="@style/Widget.HeBan.Calendar.LegendDot"
                            android:layout_marginStart="16dp"
                            android:backgroundTint="?attr/colorTertiary" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.LegendText"
                            android:text="@string/calendar_legend_irrigate" />

                        <View
                            style="@style/Widget.HeBan.Calendar.LegendDot"
                            android:layout_marginStart="16dp"
                            android:backgroundTint="?attr/colorError" />

                        <TextView
                            style="@style/Widget.HeBan.Calendar.LegendText"
                            android:text="@string/calendar_legend_pest" />
                    </LinearLayout>

                    <!-- 当日农事 -->
                    <LinearLayout
                        android:id="@+id/section"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/calendar_section_bg"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="88dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:accessibilityHeading="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="10月10日 周六" />

                            <TextView
                                android:id="@+id/tv_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="· 3 项" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_tasks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="@dimen/corner_large"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/task_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- 空状态：图标 64（圆形底）+ 标题 + 一句说明 -->
                        <LinearLayout
                            android:id="@+id/empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="24dp"
                            android:paddingBottom="16dp"
                            app:visible="@{vm.empty}">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/calendar_oval"
                                android:backgroundTint="?attr/colorSecondaryContainer"
                                android:importantForAccessibility="no"
                                android:scaleType="center"
                                android:src="@drawable/ic_event_available"
                                app:tint="?attr/colorOnSecondaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="@string/calendar_empty_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="@string/calendar_empty_desc"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 节气提示 -->
                        <LinearLayout
                            android:id="@+id/term_tip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/calendar_tip_bg"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tips_and_updates"
                                app:tint="?attr/colorOnTertiaryContainer" />

                            <TextView
                                android:id="@+id/tv_term_tip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnTertiaryContainer"
                                tools:text="霜降（10月23日）前后注意防霜冻，露天地块适时完成冬小麦播种。" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/calendar_add_task"
            android:onClick="@{() -> vm.addTask()}"
            app:srcCompat="@drawable/ic_add" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
