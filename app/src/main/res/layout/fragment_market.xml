<?xml version="1.0" encoding="utf-8"?>
<!-- D07 农产品集市（原型 Market.dc.html）：顶栏（搜索 / 收藏）、分类 Chip、「江宁区附近 · N 件」+ 排序、
     两列商品网格（Paging 3）、右下角「发布」扩展 FAB -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.heban.app.ui.discover.market.MarketViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.HeBan.Toolbar"
                android:layout_width="match_parent"
                android:paddingEnd="4dp"
                app:contentInsetEndWithActions="0dp"
                app:menu="@menu/market_toolbar"
                app:navigationContentDescription="@string/back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="@string/market_title">

                <!-- 搜索：点击顶栏搜索图标后替换标题 -->
                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:autofillHints="none"
                    android:background="@null"
                    android:hint="@string/market_search"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:text="@={vm.search}"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </com.google.android.material.appbar.MaterialToolbar>

            <!-- 分类 Chip（Chip 触控区 48dp，上下各 8dp 透明区，用负边距抵消） -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="-8dp"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/page_margin"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/chip_gap"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_all"
                        style="@style/Widget.HeBan.Market.CategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/market_cat_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_produce"
                        style="@style/Widget.HeBan.Market.CategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/market_cat_produce" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_supply"
                        style="@style/Widget.HeBan.Market.CategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/market_cat_supply" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_seedling"
                        style="@style/Widget.HeBan.Market.CategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/market_cat_seedling" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_machine"
                        style="@style/Widget.HeBan.Market.CategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/market_cat_machine" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 江宁区附近 · 36 件 + 排序 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/page_margin"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_near_me"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="江宁区附近 · 36 件" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sort"
                    style="@style/Widget.HeBan.Market.SortButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:contentDescription="@{@string/market_sort_desc(vm.sort)}"
                    android:text="@{vm.sort}"
                    app:icon="@drawable/ic_arrow_drop_down"
                    tools:text="@string/market_sort_distance" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1">

                <!-- 两列网格：左右各 10dp + 卡片两侧 6dp = 页边距 16dp、列间距 12dp -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="96dp"
                    tools:listitem="@layout/market_item_product" />

                <include
                    android:id="@+id/empty"
                    layout="@layout/market_view_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_publish"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:text="@string/market_publish"
            app:icon="@drawable/ic_add"
            app:iconPadding="12dp" />
    </FrameLayout>
</layout>
