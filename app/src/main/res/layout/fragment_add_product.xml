<?xml version="1.0" encoding="utf-8"?>
<!-- D09 发布商品（原型 AddProduct.dc.html）：图片行（封面 + 最多 9 张、视频、添加 N/9）、标题、分类 / 起售量、
     价格 / 单位、交易方式、交易地点、描述、置顶 24 小时、附上种植记录 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.heban.app.ui.discover.market.AddProductViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.HeBan.Toolbar"
            android:layout_width="match_parent"
            app:contentInsetEnd="0dp"
            app:contentInsetEndWithActions="0dp"
            app:navigationContentDescription="@string/add_product_close"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/add_product_title">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publish"
                style="@style/Widget.HeBan.AddProduct.PublishButton"
                android:enabled="@{!safeUnbox(vm.busy)}"
                android:text="@string/add_product_publish" />
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="@dimen/section_gap">

                <!-- 图片行：88dp 方块，间距 8dp -->
                <HorizontalScrollView
                    android:id="@+id/photo_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/page_margin"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/photo_strip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                        <!-- 视频：暂未开放 -->
                        <FrameLayout
                            android:id="@+id/tile_video"
                            android:layout_width="@dimen/add_product_tile"
                            android:layout_height="@dimen/add_product_tile"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/add_product_bg_tile"
                            android:clickable="true"
                            android:contentDescription="@string/add_product_video"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_videocam"
                                app:tint="?attr/colorOutline" />
                        </FrameLayout>

                        <!-- 添加图片：虚线框 + 「3/9」 -->
                        <LinearLayout
                            android:id="@+id/tile_add"
                            android:layout_width="@dimen/add_product_tile"
                            android:layout_height="@dimen/add_product_tile"
                            android:background="@drawable/add_product_bg_add_tile"
                            android:clickable="true"
                            android:contentDescription="@string/add_product_add_media"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_add_photo_alternate"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_photo_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorPrimary"
                                tools:text="3/9" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/photo_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorSize="20dp" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tv_photo_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/page_margin"
                    android:layout_marginTop="8dp"
                    android:text="@string/add_product_photo_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/page_margin">

                    <!-- 标题：最多 30 字，右侧「11/30」 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_title"
                        style="@style/Widget.HeBan.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_product_field_gap"
                        android:hint="@string/add_product_field_title"
                        app:suffixTextAppearance="?attr/textAppearanceBodySmall"
                        app:suffixTextColor="?attr/colorOnSurfaceVariant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLength="30"
                            android:maxLines="1"
                            android:text="@={vm.title}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 分类 | 起售量 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_product_field_gap"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_category"
                            style="@style/Widget.HeBan.TextInputLayout.Dropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/add_product_category"
                            app:endIconTint="?attr/colorOnSurfaceVariant">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/et_category"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_min_qty"
                            style="@style/Widget.HeBan.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:hint="@string/add_product_min_qty"
                            app:suffixTextColor="?attr/colorOnSurface">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_min_qty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:maxLength="8"
                                android:text="@={vm.minQty}" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 价格（元）| 单位 128dp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_product_field_gap"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_price"
                            style="@style/Widget.HeBan.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/add_product_price"
                            app:prefixText="@string/add_product_price_prefix"
                            app:prefixTextColor="?attr/colorOnSurfaceVariant">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_price"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:maxLength="10"
                                android:text="@={vm.price}" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_unit"
                            style="@style/Widget.HeBan.TextInputLayout.Dropdown"
                            android:layout_width="128dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:hint="@string/add_product_unit"
                            app:endIconTint="?attr/colorOnSurfaceVariant">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/et_unit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 交易方式 可多选 -->
                    <TextView
                        android:id="@+id/tv_trade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_product_gap"
                        android:accessibilityHeading="true"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="交易方式 可多选" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/trade_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:chipSpacingHorizontal="@dimen/chip_gap"
                        app:chipSpacingVertical="0dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_pickup"
                            style="@style/Widget.HeBan.AddProduct.TradeChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_local"
                            style="@style/Widget.HeBan.AddProduct.TradeChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_express"
                            style="@style/Widget.HeBan.AddProduct.TradeChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_talk"
                            style="@style/Widget.HeBan.AddProduct.TradeChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- 交易地点：点击修改 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_location"
                        style="@style/Widget.HeBan.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/add_product_location"
                        app:endIconContentDescription="@string/add_product_location_edit"
                        app:endIconDrawable="@drawable/ic_chevron_right"
                        app:endIconMode="custom"
                        app:endIconTint="?attr/colorOnSurfaceVariant"
                        app:startIconDrawable="@drawable/ic_location_on"
                        app:startIconTint="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:longClickable="false"
                            android:text="@{vm.location}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 描述 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_desc"
                        style="@style/Widget.HeBan.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_product_field_gap"
                        android:hint="@string/add_product_desc">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:maxLength="500"
                            android:minHeight="88dp"
                            android:text="@={vm.desc}" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 置顶 24 小时：Warning Container -->
                    <LinearLayout
                        android:id="@+id/card_pin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_product_gap"
                        android:background="@drawable/add_product_bg_card"
                        android:backgroundTint="?attr/colorWarningContainer"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_vertical_align_top"
                            app:tint="?attr/colorOnWarningContainer" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_product_pin"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnWarningContainer" />

                            <TextView
                                android:id="@+id/tv_pin_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnWarningContainer"
                                tools:text="100 积分，排在集市列表最前（我的积分 1,280）" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_pin"
                            style="@style/Widget.HeBan.AddProduct.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/add_product_pin" />
                    </LinearLayout>

                    <!-- 附上种植记录：Surface Container Low；没有作物时隐藏 -->
                    <LinearLayout
                        android:id="@+id/card_record"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/add_product_gap"
                        android:background="@drawable/add_product_bg_card"
                        android:backgroundTint="?attr/colorSurfaceContainerLow"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_history_edu"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:id="@+id/record_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_product_record"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tv_record_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="展示「草莓 · 2号大棚」的施肥用药记录，买家更放心" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_record"
                            style="@style/Widget.HeBan.AddProduct.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/add_product_record" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
