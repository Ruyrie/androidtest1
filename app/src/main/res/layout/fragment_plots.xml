<?xml version="1.0" encoding="utf-8"?>
<!-- C05 地块管理（原型 Plots.dc.html）：统计块、地块卡片、添加地块 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.heban.app.ui.crop.PlotsViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.HeBan.Toolbar"
            android:layout_width="match_parent"
            android:paddingEnd="4dp"
            app:contentInsetEndWithActions="0dp"
            app:menu="@menu/plots_toolbar"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/plots_title" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                app:visible="@{safeUnbox(vm.hasPlots)}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/page_margin"
                    android:paddingTop="4dp"
                    android:paddingBottom="@dimen/page_margin">

                    <!-- 统计：地块（Primary Container）/ 总面积（亩）/ 利用率，圆角 16dp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/plots_bg_stat"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tv_stat_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.valueOf(vm.stats.count)}"
                                android:textAppearance="@style/TextAppearance.HeBan.Crops.StatValue"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/plots_stat_count"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/plots_bg_stat"
                            android:backgroundTint="?attr/colorSurfaceContainerHighest"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tv_stat_area"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{com.heban.app.ui.crop.CropsFormat.area(vm.stats.totalAreaMu)}"
                                android:textAppearance="@style/TextAppearance.HeBan.Crops.StatValue"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/plots_stat_area"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/plots_bg_stat"
                            android:backgroundTint="?attr/colorSurfaceContainerHighest"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/tv_stat_utilization"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{@string/plots_percent(vm.stats.utilization)}"
                                android:textAppearance="@style/TextAppearance.HeBan.Crops.StatValue"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/plots_stat_utilization"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <!-- 添加地块：72dp，虚线描边 -->
                    <LinearLayout
                        android:id="@+id/btn_add_plot"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:background="@drawable/plots_bg_add"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/plots_add"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- 还没有地块 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="64dp"
                app:visible="@{safeUnbox(vm.loaded) &amp;&amp; !safeUnbox(vm.hasPlots)}">

                <include
                    android:id="@+id/empty"
                    layout="@layout/crops_view_empty"
                    app:action="@{@string/plots_add}"
                    app:desc="@{@string/plots_empty_desc}"
                    app:icon="@{@drawable/ic_landscape}"
                    app:large="@{true}"
                    app:title="@{@string/plots_empty_title}" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
