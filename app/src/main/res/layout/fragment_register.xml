<?xml version="1.0" encoding="utf-8"?>
<!-- A05 注册（原型 Register.dc.html）：验证手机号并设置登录密码 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="vm"
            type="com.heban.app.ui.account.RegisterViewModel" />

        <variable
            name="openAgreement"
            type="android.view.View.OnClickListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.HeBan.Toolbar"
            android:layout_width="match_parent"
            app:navigationContentDescription="@string/back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/register_title" />

        <!-- 注册进度：第 1 步，共 2 步 -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            style="@style/Widget.Material3.LinearProgressIndicator.Legacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/register_progress"
            android:max="2"
            android:progress="1"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSecondaryContainer"
            app:trackThickness="4dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_step1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/register_step1_desc"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- 手机号：+86 | 138 0000 5678 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_phone"
                    style="@style/Widget.HeBan.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/register_field_gap"
                    android:hint="@string/register_phone"
                    app:expandedHintEnabled="false"
                    app:prefixText="@string/register_phone_prefix"
                    app:prefixTextAppearance="?attr/textAppearanceBodyLarge"
                    app:prefixTextColor="?attr/colorOnSurfaceVariant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="yes"
                        android:autofillHints="phoneNational"
                        android:inputType="phone"
                        android:maxLength="13"
                        android:text="@={vm.phone}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 验证码：输入框 | 获取验证码 / 42s 后重发 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_code"
                    style="@style/Widget.HeBan.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/register_field_gap"
                    android:hint="@string/register_code"
                    app:expandedHintEnabled="false"
                    app:suffixText="@{vm.countdown.buttonText}"
                    app:suffixTextAppearance="?attr/textAppearanceTitleSmall">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="smsOTPCode"
                        android:inputType="number"
                        android:maxLength="6"
                        android:text="@={vm.code}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 设置密码 + 强度条 + 规则 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.HeBan.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/register_field_gap"
                    android:hint="@string/register_password"
                    app:endIconContentDescription="@string/register_password_toggle"
                    app:endIconDrawable="@drawable/register_password_toggle"
                    app:endIconMode="password_toggle"
                    app:endIconTint="?attr/colorOnSurfaceVariant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:text="@={vm.password}" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/strength_seg1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/register_strength_segment" />

                        <View
                            android:id="@+id/strength_seg2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/register_strength_segment" />

                        <View
                            android:id="@+id/strength_seg3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/register_strength_segment" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_strength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@{@string/register_strength(vm.strength.label())}"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/tv_rule_length"
                        style="@style/Widget.HeBan.Register.Rule"
                        android:text="@string/register_rule_length" />

                    <TextView
                        android:id="@+id/tv_rule_letter"
                        style="@style/Widget.HeBan.Register.Rule"
                        android:layout_marginStart="16dp"
                        android:text="@string/register_rule_letter" />

                    <TextView
                        android:id="@+id/tv_rule_digit"
                        style="@style/Widget.HeBan.Register.Rule"
                        android:layout_marginStart="16dp"
                        android:text="@string/register_rule_digit" />
                </LinearLayout>

                <!-- 确认密码：一致时显示对勾，不一致时框下方提示 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_confirm"
                    style="@style/Widget.HeBan.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/register_confirm_gap"
                    android:hint="@string/register_confirm_password"
                    app:endIconContentDescription="@string/register_password_match"
                    app:endIconDrawable="@drawable/ic_check_circle_fill"
                    app:endIconMode="custom"
                    app:endIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:text="@={vm.confirmPassword}" />
                </com.google.android.material.textfield.TextInputLayout>

                <include
                    android:id="@+id/agreement"
                    layout="@layout/view_agreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/register_checkbox_offset"
                    android:layout_marginTop="@dimen/register_agreement_gap"
                    app:agreed="@{vm.agreed}"
                    app:onOpenAgreement="@{openAgreement}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next"
                    style="@style/Widget.HeBan.Register.Cta"
                    android:layout_marginTop="@dimen/register_agreement_gap"
                    android:enabled="@{vm.canNext}"
                    android:onClick="@{() -> vm.next()}"
                    android:text="@string/register_next" />

                <LinearLayout
                    android:id="@+id/btn_to_login"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_has_account"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_go_login"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
