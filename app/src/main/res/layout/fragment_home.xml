<?xml version="1.0" encoding="utf-8"?>
<!-- H01 首页（原型 Main.dc.html / HomeDark.dc.html） -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.heban.app.ui.home.WeatherFormat" />

        <variable
            name="vm"
            type="com.heban.app.ui.home.HomeViewModel" />

        <variable
            name="onPickCity"
            type="android.view.View.OnClickListener" />

        <variable
            name="onAddTask"
            type="android.view.View.OnClickListener" />

        <variable
            name="onAddCrop"
            type="android.view.View.OnClickListener" />
    </data>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="96dp">

                <!-- 顶部：日期 · 地点、问候语、消息、头像（高 72dp） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/page_margin"
                    android:paddingTop="8dp"
                    android:paddingEnd="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/header_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{WeatherFormat.headerDate(context, vm.now, vm.state.weather.locationName())}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{context.getString(vm.greetingRes, vm.nickname ?? @string/home_guest_name)}"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btn_messages"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@{vm.state.showUnreadDot ? @string/home_cd_messages_unread : @string/home_cd_messages}">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_notifications"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <View
                            android:id="@+id/unread_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/home_bg_dot"
                            app:visible="@{vm.state.showUnreadDot}" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_profile"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/home_cd_profile">

                        <TextView
                            android:id="@+id/avatar"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/home_bg_circle"
                            android:backgroundTint="?attr/colorPrimary"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@{vm.avatarText ?? @string/home_guest_avatar}"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnPrimary" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/page_margin"
                    android:paddingTop="8dp">

                    <!-- 离线提示栏 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/card_gap"
                        app:visible="@{vm.state.weather.showOffline()}">

                        <include
                            android:id="@+id/offline"
                            layout="@layout/weather_view_offline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:text="@{WeatherFormat.offlineText(context, vm.state.weather)}" />
                    </FrameLayout>

                    <!-- 天气主卡：Primary Container，圆角 28 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/weather_card"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/home_cd_weather"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer"
                        app:cardCornerRadius="@dimen/corner_extra_large"
                        app:visible="@{vm.state.weather.hasData()}">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- Display Large 57/64：去掉字体内边距，行高固定 64dp -->
                                <TextView
                                    android:id="@+id/weather_temp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="64dp"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:text="@{WeatherFormat.nowTemp(vm.state.weather)}"
                                    android:textAppearance="?attr/textAppearanceDisplayLarge"
                                    android:textColor="?attr/colorOnPrimaryContainer" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/icon_text_gap"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/weather_text"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@{WeatherFormat.nowText(vm.state.weather)}"
                                        android:textAppearance="?attr/textAppearanceTitleMedium"
                                        android:textColor="?attr/colorOnPrimaryContainer" />

                                    <TextView
                                        android:id="@+id/weather_detail"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@{WeatherFormat.homeDetail(context, vm.state.weather.bundle())}"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnPrimaryContainer" />
                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/weather_icon"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:importantForAccessibility="no"
                                    android:src="@{context.getDrawable(WeatherFormat.nowIcon(vm.state.weather.bundle()))}"
                                    app:tint="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:alpha="0.2"
                                android:background="?attr/colorOnPrimaryContainer" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/tip_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:importantForAccessibility="no"
                                    android:src="@{context.getDrawable(WeatherFormat.tipIcon(vm.state.weather.farmTip()))}"
                                    app:tint="?attr/colorOnPrimaryContainer"
                                    app:visible="@{vm.state.weather.farmTip() != null}" />

                                <TextView
                                    android:id="@+id/tip_text"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@{WeatherFormat.tip(vm.state.weather)}"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnPrimaryContainer" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/home_forecast_15"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer" />

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="8dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 骨架屏：首次加载天气 -->
                    <LinearLayout
                        android:id="@+id/weather_skeleton"
                        android:layout_width="match_parent"
                        android:layout_height="138dp"
                        android:background="@drawable/home_bg_round28"
                        android:backgroundTint="?attr/colorSurfaceContainerLow"
                        android:contentDescription="@string/weather_loading"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        app:visible="@{vm.state.weather.showSkeleton()}">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="88dp"
                                android:layout_height="56dp"
                                android:background="@drawable/home_bg_round12"
                                android:backgroundTint="?attr/colorSurfaceContainerHighest" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/icon_text_gap"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="72dp"
                                    android:layout_height="16dp"
                                    android:background="@drawable/home_bg_round8"
                                    android:backgroundTint="?attr/colorSurfaceContainerHighest" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="12dp"
                                    android:layout_marginTop="10dp"
                                    android:background="@drawable/home_bg_round8"
                                    android:backgroundTint="?attr/colorSurfaceContainerHighest" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/home_bg_round8"
                            android:backgroundTint="?attr/colorSurfaceContainerHighest" />
                    </LinearLayout>

                    <!-- 没有缓存时的报错 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:visible="@{vm.state.weather.showError()}">

                        <include
                            android:id="@+id/weather_error"
                            layout="@layout/weather_view_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:onPickCity="@{onPickCity}"
                            app:onRetry="@{v -> vm.refresh()}"
                            app:ui="@{vm.state.weather}" />
                    </FrameLayout>

                    <!-- 降温预警：Warning Container -->
                    <LinearLayout
                        android:id="@+id/alert_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/home_bg_round12"
                        android:backgroundTint="?attr/colorWarningContainer"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp"
                        android:paddingStart="@dimen/page_margin"
                        android:paddingEnd="8dp"
                        app:visible="@{vm.state.weather.showAlert()}">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ac_unit"
                            app:tint="?attr/colorOnWarningContainer" />

                        <TextView
                            android:id="@+id/alert_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@{WeatherFormat.homeAlert(vm.state.weather)}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnWarningContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_alert_view"
                            style="@style/Widget.HeBan.Home.AlertButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:text="@string/home_alert_view" />
                    </LinearLayout>

                    <!-- 常用工具 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <LinearLayout
                            android:id="@+id/tool_scan"
                            style="@style/Widget.HeBan.Home.Tool">

                            <FrameLayout
                                style="@style/Widget.HeBan.Home.ToolBox"
                                android:backgroundTint="?attr/colorPrimaryContainer">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_photo_camera"
                                    app:tint="?attr/colorOnPrimaryContainer" />
                            </FrameLayout>

                            <TextView
                                style="@style/Widget.HeBan.Home.ToolLabel"
                                android:text="@string/home_tool_scan" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tool_calendar"
                            style="@style/Widget.HeBan.Home.Tool">

                            <FrameLayout
                                style="@style/Widget.HeBan.Home.ToolBox"
                                android:backgroundTint="?attr/colorSecondaryContainer">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_calendar_month"
                                    app:tint="?attr/colorOnSecondaryContainer" />
                            </FrameLayout>

                            <TextView
                                style="@style/Widget.HeBan.Home.ToolLabel"
                                android:text="@string/home_tool_calendar" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tool_ledger"
                            style="@style/Widget.HeBan.Home.Tool">

                            <FrameLayout
                                style="@style/Widget.HeBan.Home.ToolBox"
                                android:backgroundTint="?attr/colorTertiaryContainer">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_receipt_long"
                                    app:tint="?attr/colorOnTertiaryContainer" />
                            </FrameLayout>

                            <TextView
                                style="@style/Widget.HeBan.Home.ToolLabel"
                                android:text="@string/home_tool_ledger" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tool_checkin"
                            style="@style/Widget.HeBan.Home.Tool">

                            <FrameLayout
                                style="@style/Widget.HeBan.Home.ToolBox"
                                android:backgroundTint="?attr/colorWarningContainer">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_event_available"
                                    app:tint="?attr/colorOnWarningContainer" />

                                <!-- 今日未签到的小红点（签到数据接入前保持原型样式） -->
                                <View
                                    android:id="@+id/checkin_dot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="6dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/home_bg_dot" />
                            </FrameLayout>

                            <TextView
                                style="@style/Widget.HeBan.Home.ToolLabel"
                                android:text="@string/home_tool_checkin" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 今日农事 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/card_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:text="@string/home_tasks_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tasks_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@{@string/home_tasks_summary(vm.state.taskCount, vm.state.doneCount)}"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:visible="@{vm.state.hasTasks()}" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tasks_all"
                            style="@style/Widget.HeBan.Home.LinkButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/home_all" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/home_bg_round12"
                        android:backgroundTint="?attr/colorSurfaceContainerLow"
                        android:clipToOutline="true">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/tasks_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            app:visible="@{vm.state.hasTasks()}" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:visible="@{vm.state.tasksEmpty}">

                            <include
                                android:id="@+id/tasks_empty"
                                layout="@layout/home_view_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:action="@{@string/home_tasks_empty_action}"
                                app:desc="@{@string/home_tasks_empty_desc}"
                                app:icon="@{@drawable/ic_task_alt}"
                                app:onAction="@{onAddTask}"
                                app:title="@{@string/home_tasks_empty_title}" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- 我的作物 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/card_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/home_crops_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_crops_all"
                            style="@style/Widget.HeBan.Home.LinkButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@{vm.state.hasCrops() ? @string/home_crops_all(vm.state.cropCount) : @string/home_all}" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/home_bg_round12"
                        android:backgroundTint="?attr/colorSurfaceContainerLow"
                        app:visible="@{vm.state.cropsEmpty}">

                        <include
                            android:id="@+id/crops_empty"
                            layout="@layout/home_view_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:action="@{@string/home_crops_empty_action}"
                            app:desc="@{@string/home_crops_empty_desc}"
                            app:icon="@{@drawable/ic_potted_plant}"
                            app:onAction="@{onAddCrop}"
                            app:title="@{@string/home_crops_empty_title}" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 作物卡片横向列表：左右留 16dp，卡片可滑出屏幕边缘 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/crops_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="@dimen/page_margin"
                    android:paddingVertical="2dp"
                    app:visible="@{vm.state.hasCrops()}" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</layout>
