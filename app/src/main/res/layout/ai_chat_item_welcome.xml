<?xml version="1.0" encoding="utf-8"?>
<!-- D06 欢迎语与建议问题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <include layout="@layout/ai_chat_view_avatar" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.HeBan.AiChat.Bubble"
            android:background="@drawable/ai_chat_bg_bubble_ai"
            android:text="@string/ai_chat_welcome" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp">

            <TextView
                android:id="@+id/chip_suggest_1"
                style="@style/Widget.HeBan.AiChat.Suggestion"
                android:text="@string/ai_chat_suggest_1" />

            <TextView
                android:id="@+id/chip_suggest_2"
                style="@style/Widget.HeBan.AiChat.Suggestion"
                android:text="@string/ai_chat_suggest_2" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</LinearLayout>
