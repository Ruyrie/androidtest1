<?xml version="1.0" encoding="utf-8"?>
<!-- H04 新建农事（原型 AddTask.dc.html）：农事类型、关联作物、日期 / 时间、重复、提醒我、备注、AI 提示 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vm"
            type="com.heban.app.ui.home.AddTaskViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.HeBan.Toolbar"
            android:layout_width="match_parent"
            app:contentInsetEnd="0dp"
            app:contentInsetEndWithActions="0dp"
            app:navigationContentDescription="@string/add_task_close"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/add_task_title">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.HeBan.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:enabled="@{!vm.saving}"
                android:minWidth="48dp"
                android:text="@string/save" />
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- 农事类型：3 列 × 2 行 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/add_task_type"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/type_row1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/type_row2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <!-- 关联作物 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_crop"
                    style="@style/Widget.HeBan.TextInputLayout.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/add_task_field_gap"
                    android:hint="@string/add_task_crop"
                    app:startIconDrawable="@drawable/ic_nutrition"
                    app:startIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/et_crop"
                    android:fallbackLineSpacing="false"
                    android:minHeight="56dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:text="番茄 · 1号大棚" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 日期 / 时间 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/add_task_field_gap"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_date"
                        style="@style/Widget.HeBan.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/add_task_date"
                        app:endIconContentDescription="@string/add_task_pick_date"
                        app:endIconDrawable="@drawable/add_task_ic_calendar"
                        app:endIconMode="custom"
                        app:endIconTint="?attr/colorOnSurfaceVariant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_date"
                        android:fallbackLineSpacing="false"
                        android:minHeight="56dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:longClickable="false"
                            tools:text="10月11日 周日" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_time"
                        style="@style/Widget.HeBan.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:hint="@string/add_task_time"
                        app:endIconContentDescription="@string/add_task_pick_time"
                        app:endIconDrawable="@drawable/add_task_ic_schedule"
                        app:endIconMode="custom"
                        app:endIconTint="?attr/colorOnSurfaceVariant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_time"
                        android:fallbackLineSpacing="false"
                        android:minHeight="56dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:longClickable="false"
                            tools:text="08:00" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 重复 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_repeat"
                    style="@style/Widget.HeBan.TextInputLayout.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/add_task_field_gap"
                    android:hint="@string/add_task_repeat">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/et_repeat"
                    android:fallbackLineSpacing="false"
                    android:minHeight="56dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:text="每 7 天，共 3 次" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 提醒我 -->
                <LinearLayout
                    android:id="@+id/row_remind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add_task_remind"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_remind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{vm.remind ? @string/add_task_remind_on : @string/add_task_remind_off}"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="@string/add_task_remind_on" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sw_remind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:checked="@{vm.remind}"
                        android:contentDescription="@string/add_task_remind"
                        app:thumbIcon="@drawable/add_task_switch_thumb_icon"
                        app:thumbIconTint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- 备注 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_note"
                    style="@style/Widget.HeBan.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/add_task_field_gap"
                    android:hint="@string/add_task_note"
                    app:expandedHintEnabled="false"
                    app:placeholderText="@string/add_task_note_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_note"
                        android:fallbackLineSpacing="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="200"
                        android:minHeight="80dp"
                        android:text="@={vm.note}" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- AI 提示（FarmIndexCalculator 根据逐小时预报，空时隐藏） -->
                <LinearLayout
                    android:id="@+id/card_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/calendar_tip_bg"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    app:visible="@{vm.tipVisible}">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_auto_awesome"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <TextView
                        android:id="@+id/tv_tip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@{@string/add_task_ai_tip(vm.tip)}"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        tools:text="AI 提示：11 日 7:00–10:00 风力 1 级、无降水，适合喷药；12 日起有降雨，建议提前完成。" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
