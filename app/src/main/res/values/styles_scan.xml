<?xml version="1.0" encoding="utf-8"?>
<!-- D02 / D03 页面样式 -->
<resources>
    <!-- D02 识别模式：高 36dp 胶囊，左右 16dp，Label Large；选中 Primary 底 + On Primary 字 -->
    <style name="Widget.HeBan.Scan.Mode" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/scan_bg_pill18</item>
        <item name="android:backgroundTint">@color/scan_mode_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/scan_mode_text</item>
    </style>

    <!-- D03 特征标签：高 24dp，圆角 8dp，Secondary Container，Label Medium -->
    <style name="Widget.HeBan.Scan.Tag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@drawable/scan_bg_round8</item>
        <item name="android:backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <!-- D03 照片 / D02 识别记录缩略图的圆角 -->
    <style name="ShapeAppearance.HeBan.Scan.Round16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_large</item>
    </style>

    <style name="ShapeAppearance.HeBan.Scan.Round8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_small</item>
    </style>
</resources>
