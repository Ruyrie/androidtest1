<?xml version="1.0" encoding="utf-8"?>
<!-- D02 快门：80dp 白色 4dp 外圈 + 62dp 白色内圆 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="4dp"
                android:color="@color/scan_shutter_ring" />
        </shape>
    </item>
    <item
        android:bottom="9dp"
        android:left="9dp"
        android:right="9dp"
        android:top="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/scan_shutter_inner" />
        </shape>
    </item>
</layer-list>
